        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "initializedAt": {
          "format": "date-time",
          "title": "Initializedat",
          "type": "string"
        },
        "availableValidTimes": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Availablevalidtimes",
          "type": "array"
